{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "loy-kratong-room",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-04",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "KRATHONG_ROOM",
        "class_name": "KrathongRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["KrathongRoom"]
    }
  ],
  "vars": {
    "INGEST_SECRET": "secret_loy_kratong_ingest_key",
    "ADMIN_TOKEN": "admin_loy_kratong_master_token"
  }
}

